<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed white outline shown on the floating button while it is in
     positioning (edit) mode, so it is obvious the button is movable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke
        android:width="3dp"
        android:color="#FFFFFF"
        android:dashWidth="8dp"
        android:dashGap="6dp" />
</shape>
